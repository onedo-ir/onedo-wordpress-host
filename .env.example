# Copy to .env and fill in values before `docker compose up`.
# docker compose reads this file automatically for ${VAR} and (via env_file) for the container.

# Container / publish
CONTAINER_NAME=wp
PORT_HTTP=80
PUBLIC_HOST=

# Panel (/panel)
PANEL_USER=admin
PANEL_PASS=changeme-panel

# FileBrowser
FILEBROWSER_USER=admin
FILEBROWSER_PASS=changeme-filebrowser

# MariaDB / WordPress
DB_NAME=wordpress
DB_USER=wordpress
DB_PASS=changeme-db
DB_ROOT_PASS=changeme-root

# Panel agent chat (OpenAI-compatible)
# base URL must include /v1 (e.g. https://onedo.ir/v1 or your proxy)
OPENAI_BASE_URL=https://onedo.ir/v1
OPENAI_API_KEY=
OPENAI_MODEL=default
